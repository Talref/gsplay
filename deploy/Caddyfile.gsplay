gsplay.daje.cc {
    encode zstd gzip

    handle /api/v2/* {
        reverse_proxy 127.0.0.1:3000
    }

    handle /uploads/guide/* {
        reverse_proxy 127.0.0.1:3000
    }

    handle /assets/* {
        root * /srv/gsplay/gsplay-frontend/dist
        file_server
    }

    @frontend_public path /8bit.ttf /gslogo.png /placeholder-game.jpg
    handle @frontend_public {
        root * /srv/gsplay/gsplay-frontend/dist
        file_server
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
