# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/gsplay

# Authentication - generate unique high-entropy values; never use these example values
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Provider integrations
STEAM_API_KEY=
# Refresh the community Steam wishlist snapshot daily and mark it stale after three days.
MOST_WANTED_REFRESH_MS=86400000
MOST_WANTED_STALE_AFTER_MS=259200000
# IsThereAnyDeal Web API key used to verify paid Casual Friday games and fetch offers.
# Create one at https://isthereanydeal.com/dev/app/
ITAD_API_KEY=
ITAD_PRICE_REFRESH_MS=3600000
# TMDB API Read Access Token used to search and add movies to Casual Friday playlists.
TMDB_READ_ACCESS_TOKEN=
# Twitch application credentials used to obtain the IGDB access token.
# IGDB_CLIENT_ID / IGDB_CLIENT_SECRET remain accepted aliases.
TW_CLIENT_ID=
TW_CLIENT_SECRET=
RETROACHIEVEMENT_USERNAME=
RETROACHIEVEMENT_API_KEY=
RETROACHIEVEMENT_REFRESH_MS=300000

# GSbot Discord runtime. Leave the token and both guild settings empty to disable its service.
# GSBOT_GUILD_IDS is a comma-separated allowlist. GSBOT_GUILD_ID remains a migration fallback.
# Retrieve the token from the Discord Developer Portal and guild IDs from Copy Server ID.
GSBOT_TOKEN=
GSBOT_GUILD_IDS=
GSBOT_GUILD_ID=

# Operations
LOG_LEVEL=info
ENABLE_WORKER=true
# Daily MongoDB archive backups. The directory must already exist and be writable by the worker.
DB_BACKUP_ENABLED=false
# DB_BACKUP_DIR=/media/backup/gsplay/db
DB_BACKUP_HOUR=4
DB_BACKUP_RETENTION_DAYS=30
UPLOAD_MAX_BYTES=10485760
# Persistent guide images. Defaults: /tmp in development, /var/lib/gsplay/guide in production.
# GUIDE_UPLOAD_DIR=/var/lib/gsplay/guide
GUIDE_IMAGE_MAX_BYTES=5242880
# n8n server-status integration. Generate with: openssl rand -hex 32
SERVER_STATUS_INTEGRATION_TOKEN=replace-with-a-dedicated-integration-token
SERVER_STATUS_MAX_BYTES=65536
SERVER_STATUS_RATE_LIMIT_WINDOW_MS=60000
SERVER_STATUS_RATE_LIMIT_MAX=10
# Mark the latest snapshot stale after three minutes without a successful update.
SERVER_STATUS_STALE_AFTER_MS=180000
# IGDB worker protection: one request every 500ms by default (well below the free API rate limit).
IGDB_MIN_INTERVAL_MS=500
IGDB_COOLDOWN_MS=60000
IGDB_MAINTENANCE_MS=900000
IGDB_QUEUE_LIMIT=100
IGDB_MAX_ATTEMPTS=6
# Development recovery for terminal state written by pre-recovery workers. Keep false in production.
IGDB_RECOVER_LEGACY_PERMANENT=true
# Dr. Racoon: independent Discord app. Both token and guild list empty disables deployment.
# Initially set ONLY your staging guild; add the final guild deliberately after acceptance.
DRRACOON_TOKEN=
DRRACOON_GUILD_IDS=
# Comma-separated numeric Discord IDs, e.g. 123456789012345678,234567890123456789.
# STAFF needs a matching role AND destination channel in the originating guild.
# For threads, list the private parent channel. These IDs are the operator's privacy guarantee.
DRRACOON_STAFF_ROLE_IDS=
DRRACOON_STAFF_CHANNEL_IDS=
DRRACOON_LLM_BASE_URL=http://127.0.0.1:10743/v1
DRRACOON_LLM_MODEL=gsbot-gemma
DRRACOON_LLM_API_KEY=
DRRACOON_CONTEXT_SIZE=32768
DRRACOON_MAX_OUTPUT_TOKENS=1024
DRRACOON_REQUEST_TIMEOUT_MS=120000
DRRACOON_MAX_CONCURRENT=1
DRRACOON_MAX_TOOL_ROUNDS=3
DRRACOON_QUEUE_LIMIT=20
# Optional provider capability; false uses nonstreaming Chat Completions.
DRRACOON_LLM_STREAM=false
# Compatibility option for providers requiring the newer completion token parameter.
DRRACOON_LLM_TOKEN_PARAMETER=max_tokens
